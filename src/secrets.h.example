// Copia questo file come "secrets.h" e metti le tue credenziali.
// secrets.h e' ignorato da git: la password del wifi non finisce
// mai in un commit.
#define WIFI_SSID     "il-nome-della-tua-rete"
#define WIFI_PASSWORD "la-password"

// Piu' di una rete - casa, l'hotspot del telefono, l'ufficio - in ordine
// di preferenza: fra quelle che vede la board prende la prima della lista. Se definisci questa
// lista, WIFI_SSID e WIFI_PASSWORD qui sopra non contano piu'.
// Le reti imparate dal telefono (toccando il pallino della rete sullo
// schermo) si aggiungono a queste e restano in memoria.
// #define WIFI_RETI \
//     {"casa", "la-password"}, \
//     {"iPhone di Nicola", "la-password-dell-hotspot"}

// Per la scheda della mappa, tutte facoltative.
//
// Dove sta la board, se lo sai: con MAPPA_DA_RETE a 0 (in main.cpp) e'
// la posizione usata; con 1 e' il ripiego finche' la rete non risponde.
// #define MAPPA_LAT 41.9028
// #define MAPPA_LON 12.4964
//
// Una chiave della Geolocation API di Google: con questa la board
// ricava la posizione dalle reti WiFi che vede intorno, a qualche
// decina di metri. Senza, si accontenta dell'indirizzo IP.
// #define GOOGLE_KEY "la-tua-chiave"
